# homer path to kdb x
KDBX_HOME=/opt/kdbx/5.0/2026.07.23

# process info
PRIMARY_PORT=45000

# 4GB currently for testing, need to run on 30GB eventually
GLOBAL_MEM_LIMIT=4294967296

# for heartbeating
HEARTBEAT_MS=1000
STALE_MS=5000

# for spinning up secondarys via the primary
SPAWN_SECONDARY=1
NUM_SECONDARYS=8
STOP_GRACE_PERIOD_SECS=5
LOG_DIR=logs

# for tasks
TASK_TIMEOUT_MS=60000  # 60 seconds timeout
TASK_RETRIES_MAX=3
TASK_TYPES=sleep,sumtil,fail,vwap,hold
RETRY_REASONS=lost,sendfailed

# mem stats from kernal
MEM_HISTORY_MAX=3600

# how many times the primary restarts a spawned secondary that dies (timeout, crash, OOM); 0 = never
RESPAWN_MAX=3

# start the primary under a cgroup with GLOBAL_MEM_LIMIT as the kernel's hard cap (bin/startprimary.sh); 0 for none
USE_CGROUP=1

# this is the multiple of the spare memory, 0 means no headroom, 0.1 means keep 10% free
MIN_HEADROOM=0

# this is the multiple of how much memory a task will use, 1 means use the current estimate 1.25 would mean estimate each task to use 25% more than the max memory task so far
ESTIMATE_MARGIN=1

# where to store results
RESULTS_DIR=/home/jrutledge/internalWork/Parallelisation-Project/results

# test hdb dir 
HDB_DIR=/home/jrutledge/internalWork/hdb