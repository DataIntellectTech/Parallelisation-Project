# homer path to kdb x
KDBX_HOME=/opt/kdbx/5.0/2026.07.23

# process info
PRIMARY_PORT=45000

# 4GB currently for testing, need to run on 30GB eventually
GLOBAL_MEM_LIMIT=4294967296

# the kernel's memory cap, in bytes: the cgroup's MemoryMax when starting under systemd-run. It must be above
# GLOBAL_MEM_LIMIT, or the kernel kills before the framework can pause; the gap is room for running tasks to keep growing after dispatch pauses.
# currently 5GB
CGROUP_MEM_LIMIT=5368709120

# for heartbeating
HEARTBEAT_MS=1000
STALE_MS=5000

# for spinning up secondarys via the primary
SPAWN_SECONDARY=1
NUM_SECONDARYS=8
STOP_GRACE_PERIOD_SECS=5
LOG_DIR=logs

# for tasks
TASK_TIMEOUT_MS=60000  # 60 seconds timeout
TASK_RETRIES_MAX=3
TASK_TYPES=sleep,sumtil,fail,vwap,hold
# have oom now so we can retry the case when we have 8 tasks of 1GB each and 4GB cap with 5 secondaries
RETRY_REASONS=lost,sendfailed,oom

# this is the multiple of the spare memory, 0 means no headroom, 0.1 means keep 10% free
MIN_HEADROOM=0

# this is the multiple of how much memory a task will use, 1 means use the current estimate 1.25 would mean estimate each task to use 25% more than the max memory task so far
ESTIMATE_MARGIN=1

# mem stats from kernal
MEM_HISTORY_MAX=3600

# how many times the primary restarts a spawned secondary that dies (timeout, crash, OOM); 0 = never
RESPAWN_MAX=3

# where to store results
RESULTS_DIR=$PWD/results

# hdb dir  if needed, secondary does not load if env var not defined
HDB_DIR=